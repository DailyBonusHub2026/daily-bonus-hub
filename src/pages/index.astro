---
import products from '../data/products.json';
const canonical = "https://dailybonushub.netlify.app/";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Daily Bonus Hub (2026): 27 Verified Free SC Links - No Code Needed</title>
  <meta name="description" content="27 verified daily free SC links & sweeps casino bonuses - all tested Sept 2, 2026. SpinQuest, Pulsz, Zula & more. No codes needed, auto-applied via link." />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="index, follow" />
  <style>
    :root{--bg:#0f1221;--card:#171a2e;--border:#262a45;--muted:#8b8fa3;--accent:#3b82f6;--blue:#2563eb;--blue-dark:#1d4ed8;--green:#22c55e;--red:#ef4444;--yellow:#eab308}
    *{margin:0;padding:0;box-sizing:border-box}
    body{background:var(--bg);color:#e2e8f0;font-family:Inter,system-ui,-apple-system,sans-serif;line-height:1.6;min-height:100vh}
    header{text-align:center;padding:50px 20px 20px;max-width:900px;margin:0 auto}
    .last-updated{font-size:.85rem;color:var(--muted);margin-bottom:8px;text-transform:uppercase;letter-spacing:.05em}
    h1{font-size:2.5rem;margin-bottom:12px;color:#fff;font-weight:800;line-height:1.2}h1 span{color:var(--accent)}
    p.subtitle{color:var(--muted);font-size:1.1rem;margin-bottom:16px}
    .disclosure{background:rgba(59,130,246,.1);border:1px solid rgba(59,130,246,.2);padding:14px 20px;border-radius:10px;font-size:.9rem;color:var(--muted);max-width:900px;margin:0 auto 28px;text-align:center}
    .author-box{max-width:900px;margin:0 auto 36px;background:var(--card);border:1px solid var(--border);border-radius:12px;padding:18px 20px;display:flex;align-items:center;gap:18px}
    .author-img{width:64px;height:64px;border-radius:50%;object-fit:cover;border:2px solid var(--accent);background:#222;display:flex;align-items:center;justify-content:center;font-weight:800;color:#fff;font-size:1.5rem}
    .author-info h3{font-size:1.05rem;color:#fff;margin-bottom:3px}.author-info p{font-size:.9rem;color:var(--muted)}
    .badge{display:inline-block;background:var(--green);color:#fff;font-size:.7rem;padding:2px 8px;border-radius:999px;margin-left:8px;font-weight:700;vertical-align:middle}
    .section-container{max-width:1200px;margin:40px auto;padding:0 20px}
    h2{font-size:1.7rem;margin-bottom:20px;color:#fff;text-align:center;font-weight:700}
    .container{display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:22px}
    .card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:22px;display:flex;flex-direction:column;justify-content:space-between;transition:.2s;text-decoration:none;color:inherit}
    .card:hover{transform:translateY(-3px);border-color:var(--accent)}
    .card-header{display:flex;align-items:center;gap:12px;margin-bottom:14px}
    .card-icon{width:48px;height:48px;border-radius:9px;background:#1a233a;display:flex;align-items:center;justify-content:center;font-weight:800;color:#fff;flex-shrink:0}
    .card-title-group h3{font-size:1.15rem;font-weight:700;color:#fff}.card-provider{font-size:.78rem;color:var(--muted)}
    .card-stats{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:14px;background:rgba(0,0,0,.25);padding:11px;border-radius:8px;font-size:.84rem}
    .stat-label{color:var(--muted);display:block;font-size:.7rem;text-transform:uppercase;letter-spacing:.04em}.stat-value{font-weight:600;color:#fff}
    .card-review{font-size:.9rem;color:var(--muted);margin-bottom:12px;line-height:1.55;min-height:44px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .pros-cons{font-size:.83rem;margin-bottom:16px}.pro{color:var(--green);margin-bottom:3px}.con{color:var(--red)}
    .card-footer{display:flex;align-items:center;justify-content:space-between;margin-top:auto;padding-top:14px;border-top:1px solid var(--border)}
    .rating{font-weight:700;color:var(--yellow);font-size:.92rem}
    .btn{display:inline-block;text-align:center;background:var(--blue);color:#fff;text-decoration:none;padding:10px 18px;border-radius:8px;font-weight:700;font-size:.88rem;transition:.15s}
    .btn:hover{background:var(--blue-dark)}
    footer{text-align:center;padding:40px 20px;color:var(--muted);font-size:.84rem;border-top:1px solid var(--border);max-width:1000px;margin:40px auto 0}
    @media(max-width:768px){h1{font-size:2rem}.container{grid-template-columns:1fr}}
  </style>
</head>
<body>
<header>
  <div class="last-updated">Last Updated: September 2, 2026 • 27 Links Verified by hand • Live</div>
  <h1>Daily Bonus Hub: <span>27 Verified Free SC</span> Bonuses</h1>
  <p class="subtitle">All 27 referral links auto-apply - no promo codes. Each has its own SEO review page.</p>
</header>

<div class="disclosure">
  <strong>Affiliate Disclosure:</strong> Contains sponsored referral links - we may earn commission. All 27 verified Sept 2, 2026. 18+ only. No purchase necessary.
</div>

<div class="author-box">
  <div class="author-img">KB</div>
  <div class="author-info">
    <h3>Tested & Verified by Keith Brubaker <span class="badge">27 PAGES LIVE</span></h3>
    <p>Each card links to a dedicated review page at /review/[slug]/ with Product schema, FAQ, and your exact referral link preserved. Dynamic Astro architecture.</p>
  </div>
</div>

<section class="section-container">
  <h2>27 Verified Review Pages — Click Any Card</h2>
  <div class="container">
    {products.map((p) => (
      <a href={`/review/${p.slug}/`} class="card">
        <div>
          <div class="card-header">
            <div class="card-icon">{p.title.slice(0,2).toUpperCase()}</div>
            <div class="card-title-group">
              <h3>{p.title}</h3>
              <div class="card-provider">{p.brand} • {p.games.split(' ')[0]}+ Games</div>
            </div>
          </div>
          <div class="card-stats">
            <div><span class="stat-label">Welcome</span><span class="stat-value">{p.welcomeBonus.slice(0,18)}</span></div>
            <div><span class="stat-label">Daily</span><span class="stat-value">{p.dailyBonus.slice(0,18)}</span></div>
            <div><span class="stat-label">Min Cashout</span><span class="stat-value">{p.minRedemption}</span></div>
            <div><span class="stat-label">Payout</span><span class="stat-value">{p.specs.payoutSpeed}</span></div>
          </div>
          <p class="card-review">{p.fullReviewText.slice(0,120)}...</p>
          <div class="pros-cons">
            <div class="pro">✓ {p.pros[0].slice(0,45)}</div>
            <div class="pro">✓ {p.pros[1].slice(0,45)}</div>
          </div>
        </div>
        <div class="card-footer">
          <span class="rating">⭐ {p.rating}/5</span>
          <span class="btn">Read Review →</span>
        </div>
      </a>
    ))}
  </div>
</section>

<footer>
  <p>&copy; 2026 Daily Bonus Hub • 27 pages • Each review has canonical, Product schema & E-E-A-T</p>
  <p>Must be 18+. No purchase necessary. Play responsibly. 1-800-GAMBLER.</p>
</footer>
</body>
</html>
