---
import products from '../data/products.json';
const canonical = "https://dailybonushub.netlify.app/";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Daily Bonus Hub (2026): 27 Verified Free SC Links - Updated Daily</title>
  <meta name="description" content="27 verified daily free SC links & sweeps casino bonuses - all tested Sept 2, 2026. SpinQuest, Pulsz, Zula & more. No codes needed." />
  <link rel="canonical" href={canonical} />
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen">
  <div class="bg-amber-500/10 border-b border-amber-500/20 py-2.5 px-4 text-center">
    <p class="text-[11px] text-amber-200/90 max-w-6xl mx-auto"><strong>Disclosure:</strong> Contains sponsored referral links - we may earn commission. Verified Sept 2, 2026. 18+ only.</p>
  </div>
  <header class="border-b border-slate-800 bg-slate-900/50 backdrop-blur sticky top-0 z-50 py-4 px-4">
    <div class="max-w-6xl mx-auto flex justify-between items-center">
      <h1 class="font-bold text-lg bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent">⚡ Daily Bonus Hub - 27 Reviews</h1>
      <span class="text-xs bg-emerald-500/10 text-emerald-400 px-2.5 py-1 rounded-full border border-emerald-500/20">Live • Sept 2</span>
    </div>
  </header>
  <main class="max-w-6xl mx-auto px-4 py-10">
    <h2 class="text-3xl font-extrabold text-center mb-8">27 Verified Review Pages - Dynamic Architecture</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {products.map((p) => (
        <a href={`/review/${p.slug}/`} class="bg-slate-900 border border-slate-800 rounded-2xl p-5 hover:border-emerald-500/30 transition block">
          <div class="flex justify-between mb-2"><h3 class="font-bold">{p.title}</h3><span class="text-xs bg-emerald-500/10 text-emerald-400 px-2 py-0.5 rounded border border-emerald-500/20">🟢 Active</span></div>
          <p class="text-sm text-slate-400 mb-3">{p.welcomeBonus} • {p.rating}/5</p>
          <span class="text-xs bg-emerald-500 text-slate-950 font-semibold px-3 py-1.5 rounded-lg">Read Review →</span>
        </a>
      ))}
    </div>
  </main>
</body>
</html>
