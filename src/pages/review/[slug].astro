---
import products from '../../data/products.json';

export async function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const pageTitle = `${product.title} Review (2026): ${product.welcomeBonus} - Verified`;
const pageDescription = `${product.title} review - Claim ${product.welcomeBonus} auto-applied via referral link. ${product.dailyBonus}, ${product.minRedemption} min. Verified ${product.lastVerified}.`;
const canonicalUrl = `https://dailybonushub.netlify.app/review/${product.slug}/`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content="index, follow" />
  <style>
    :root{--bg:#0f1221;--card:#171a2e;--border:#262a45;--muted:#8b8fa3;--accent:#3b82f6;--blue:#2563eb;--blue-dark:#1d4ed8;--green:#22c55e;--red:#ef4444;--yellow:#eab308}
    *{margin:0;padding:0;box-sizing:border-box}
    body{background:var(--bg);color:#e2e8f0;font-family:Inter,system-ui,sans-serif;line-height:1.6;min-height:100vh;display:flex;flex-direction:column}
    .disclosure{background:rgba(251,191,36,.1);border-bottom:1px solid rgba(251,191,36,.2);padding:10px 16px;text-align:center;font-size:.78rem;color:#fde68a;position:sticky;top:0;z-index:50}
    header{border-bottom:1px solid var(--border);background:rgba(23,26,46,.8);backdrop-filter:blur(10px);padding:16px 20px;position:sticky;top:36px;z-index:40}
    .header-inner{max-width:1000px;margin:0 auto;display:flex;justify-content:space-between;align-items:center}
    .logo{font-weight:800;color:#fff;text-decoration:none;font-size:1.1rem;display:flex;align-items:center;gap:8px}
    .logo span{background:linear-gradient(90deg,#34d399,#22d3ee);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
    .back{font-size:.8rem;background:#1e2238;border:1px solid var(--border);color:var(--muted);padding:6px 12px;border-radius:999px;text-decoration:none}
    main{max-width:900px;margin:0 auto;padding:28px 20px;flex:1;width:100%}
    .badge{display:inline-flex;align-items:center;gap:6px;background:rgba(34,197,94,.1);border:1px solid rgba(34,197,94,.2);color:#86efac;font-size:.7rem;font-weight:800;letter-spacing:.08em;padding:4px 10px;border-radius:999px;text-transform:uppercase;margin-bottom:16px}
    .dot{width:6px;height:6px;background:var(--green);border-radius:50%;animation:pulse 2s infinite}
    @keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}
    h1{font-size:2.2rem;font-weight:800;line-height:1.15;color:#fff;margin-bottom:14px;text-align:center}
    h1 span{color:#38bdf8}
    .lead{color:var(--muted);text-align:center;max-width:680px;margin:0 auto 28px;font-size:.98rem}
    .grid-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:24px}
    .stat-card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:14px}
    .stat-label{font-size:.65rem;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;font-weight:700;display:block;margin-bottom:4px}
    .stat-value{font-size:1rem;font-weight:700;color:#fff}
    .stat-sub{font-size:.72rem;color:var(--muted);margin-top:2px}
    .panel{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:22px;margin-bottom:22px}
    .panel h2{font-size:1.2rem;color:#fff;margin-bottom:14px;text-align:left}
    .pros-cons{display:grid;grid-template-columns:1fr 1fr;gap:18px}
    .pros-cons h3{font-size:.9rem;margin-bottom:8px}.pros-cons h3.green{color:var(--green)}.pros-cons h3.red{color:var(--red)}
    .pros-cons ul{list-style:none;font-size:.88rem;color:#cbd5e1}.pros-cons li{margin-bottom:6px;padding-left:14px;position:relative}.pros-cons li::before{content:"•";position:absolute;left:0}
    .cta{text-align:center;margin:20px 0}
    .btn-primary{display:inline-block;background:var(--blue);color:#fff;font-weight:800;padding:14px 28px;border-radius:12px;text-decoration:none;font-size:1rem;transition:.15s}
    .btn-primary:hover{background:var(--blue-dark);transform:translateY(-1px)}
    .btn-sub{font-size:.72rem;color:var(--muted);margin-top:8px}
    .specs{display:grid;grid-template-columns:1fr 1fr;gap:0;font-size:.88rem}
    .spec-row{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border)}
    .spec-row span:first-child{color:var(--muted)}.spec-row span:last-child{color:#fff;font-weight:600}
    .review-text{color:#cbd5e1;font-size:.95rem;line-height:1.7}
    .author{display:flex;gap:12px;background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:12px;padding:16px;margin-top:22px}
    .author-avatar{width:44px;height:44px;border-radius:50%;background:rgba(37,99,235,.2);border:1px solid rgba(37,99,235,.3);display:flex;align-items:center;justify-content:center;font-weight:800;color:#93c5fd;flex-shrink:0}
    footer{border-top:1px solid var(--border);padding:32px 20px;text-align:center;color:var(--muted);font-size:.78rem;margin-top:30px}
    @media(max-width:700px){h1{font-size:1.7rem}.grid-stats{grid-template-columns:1fr}.pros-cons{grid-template-columns:1fr}.specs{grid-template-columns:1fr}}
  </style>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context":"https://schema.org",
    "@type":"Product",
    "name": `${product.title} - ${product.welcomeBonus}`,
    "brand": {"@type":"Brand","name": product.brand},
    "description": product.fullReviewText,
    "aggregateRating": {"@type":"AggregateRating","ratingValue": product.rating,"reviewCount": product.reviewCount,"bestRating":"5","worstRating":"1"},
    "offers": {"@type":"Offer","price":"0","priceCurrency":"USD","availability":"https://schema.org/InStock","url": product.affiliateUrl}
  })}></script>
</head>
<body>
  <div class="disclosure"><strong>Affiliate Disclosure:</strong> Contains referral link — may earn commission • Verified {product.lastVerified} • 18+ only • <a href="https://www.ncpgambling.org/help-treatment/" style="color:#fde68a;text-decoration:underline">1-800-GAMBLER</a></div>
  <header><div class="header-inner"><a href="/" class="logo">⚡ <span>Daily Bonus Hub</span></a><a href="/" class="back">← All 27</a></div></header>
  <main>
    <div style="text-align:center">
      <div class="badge"><span class="dot"></span> Verified {product.lastVerified} • No Code Needed</div>
      <h1>{product.title} Review: <span>{product.welcomeBonus}</span></h1>
      <p class="lead">Claim {product.welcomeBonus} auto-applied via referral link. {product.dailyBonus}. Independent hands-on testing.</p>
    </div>

    <div class="panel">
      <div class="grid-stats">
        <div class="stat-card"><span class="stat-label">Welcome Bonus</span><span class="stat-value">{product.welcomeBonus}</span><div class="stat-sub">Auto-applied via link</div></div>
        <div class="stat-card"><span class="stat-label">Daily Bonus</span><span class="stat-value">{product.dailyBonus}</span><div class="stat-sub">Log in daily</div></div>
        <div class="stat-card"><span class="stat-label">Min Redemption</span><span class="stat-value">{product.minRedemption}</span><div class="stat-sub">1x playthrough</div></div>
      </div>

      <div class="pros-cons">
        <div><h3 class="green">✅ Pros</h3><ul>{product.pros.map((p)=><li>{p}</li>)}</ul></div>
        <div><h3 class="red">❌ Cons</h3><ul>{product.cons.map((c)=><li>{c}</li>)}</ul></div>
      </div>

      <div class="cta">
        <a href={product.affiliateUrl} target="_blank" rel="sponsored nofollow" class="btn-primary">Claim {product.title} Bonus →</a>
        <div class="btn-sub">Takes 30s • No code • {product.states}</div>
      </div>
    </div>

    <div class="panel">
      <h2>Quick Specs</h2>
      <div class="specs">
        <div class="spec-row"><span>Games</span><span>{product.games}</span></div>
        <div class="spec-row"><span>Platform</span><span>{product.specs.platform}</span></div>
        <div class="spec-row"><span>Payout Speed</span><span>{product.specs.payoutSpeed}</span></div>
        <div class="spec-row"><span>KYC</span><span>{product.specs.kycRequired}</span></div>
        <div class="spec-row"><span>States</span><span>40+ states</span></div>
        <div class="spec-row"><span>Rating</span><span>{product.rating}/5 ({product.reviewCount})</span></div>
      </div>
    </div>

    <div class="panel">
      <h2>Full {product.title} Review</h2>
      <p class="review-text">{product.fullReviewText.replace('Based in Kentucky, we','We').replace('Keith has tested','We have tested')}</p>
      <div class="author">
        <div class="author-avatar">DBH</div>
        <div><div style="font-weight:700;color:#fff;font-size:.9rem">Independently Tested • Verified {product.lastVerified}</div><div style="color:var(--muted);font-size:.85rem;margin-top:4px">We personally register, claim daily bonuses for 4 days, and complete a test redemption. Only sites we've cashed out from are listed. Testing since 2023.</div></div>
      </div>
    </div>

    <div style="text-align:center">
      <a href={product.affiliateUrl} target="_blank" rel="sponsored nofollow" class="btn-primary">Play {product.title} Now →</a>
      <div style="margin-top:12px"><a href="/" style="color:var(--muted);font-size:.85rem">← Back to all 27 bonuses</a></div>
    </div>
  </main>
  <footer>Must be 18+ to play. No purchase necessary. Play responsibly. 1-800-GAMBLER. Not affiliated with {product.title}.<br/>&copy; 2026 Daily Bonus Hub • Verified {product.lastVerified}</footer>
</body>
</html>
